{
  "name": "create-agent-mailbox",
  "version": "0.1.0",
  "description": "Create and deploy a self-hosted Agent Mailbox on Cloudflare.",
  "keywords": [
    "cloudflare",
    "disposable-email",
    "email-testing",
    "mcp",
    "testing"
  ],
  "homepage": "https://github.com/stumct/agent-mailbox#readme",
